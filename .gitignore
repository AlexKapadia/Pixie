# Logs
*.log

# --- Pixie: infrastructure only on main ----------------------------------
# Never push run outputs, datasets, model weights, secrets, or local state.
artefacts/
pixie.db
pixie.db-journal
pixie.db-wal
pixie.db-shm
pixie.db.bak
pixie.db.test
pixie.db.test-*
.env
.env.*
!.env.example

# Tools directory is local-only. Fresh clones start empty so contributors
# build their own. .gitkeep preserves the directory.
tools/*
!tools/.gitkeep
# CI helper scripts (not user tools) — tracked.
!tools/ci/
!tools/ci/**

# Python build/cache
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.cache/
.build/

# Playwright / test scratch
.playwright-verify/
node_modules/

# Top-level Python venv
.venv/
Master Prompt.md

