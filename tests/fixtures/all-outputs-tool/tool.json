{
  "id": "all-outputs",
  "name": "All Outputs",
  "description": "Fixture tool that returns one of every output type for renderer testing.",
  "version": "0.1.0",
  "category": "fixture",
  "icon": "layers",
  "layout": "form",
  "warm_keep_seconds": 60,
  "max_memory_mb": 256,
  "max_runtime_seconds": 10,
  "secrets": [],
  "inputs": [
    {
      "key": "seed",
      "type": "number",
      "label": "Random seed",
      "default": 42,
      "min": 0,
      "max": 10000,
      "step": 1
    }
  ],
  "outputs": [
    { "key": "o_text",        "type": "text",        "label": "Text" },
    { "key": "o_markdown",    "type": "markdown",    "label": "Markdown" },
    { "key": "o_number",      "type": "number",      "label": "Number", "format": "currency", "precision": 2 },
    { "key": "o_boolean",     "type": "boolean",     "label": "Boolean", "true_label": "Yes", "false_label": "No" },
    { "key": "o_kv",          "type": "kv",          "label": "Key-value pairs" },
    { "key": "o_table",       "type": "table",       "label": "Table",
      "columns": [
        { "key": "name",  "label": "Name",  "type": "text"   },
        { "key": "score", "label": "Score", "type": "number" }
      ],
      "downloadable": true
    },
    { "key": "o_chart_line",        "type": "chart_line",        "label": "Line chart" },
    { "key": "o_chart_bar",         "type": "chart_bar",         "label": "Bar chart" },
    { "key": "o_chart_scatter",     "type": "chart_scatter",     "label": "Scatter chart" },
    { "key": "o_chart_area",        "type": "chart_area",        "label": "Area chart" },
    { "key": "o_chart_pie",         "type": "chart_pie",         "label": "Pie chart" },
    { "key": "o_chart_histogram",   "type": "chart_histogram",   "label": "Histogram" },
    { "key": "o_chart_boxplot",     "type": "chart_boxplot",     "label": "Box plot" },
    { "key": "o_chart_heatmap",     "type": "chart_heatmap",     "label": "Heatmap" },
    { "key": "o_chart_candlestick", "type": "chart_candlestick", "label": "Candlestick" },
    { "key": "o_chart_radar",       "type": "chart_radar",       "label": "Radar" },
    { "key": "o_chart_sankey",      "type": "chart_sankey",      "label": "Sankey" },
    { "key": "o_chart_treemap",     "type": "chart_treemap",     "label": "Treemap" },
    { "key": "o_chart_network",     "type": "chart_network",     "label": "Network" },
    { "key": "o_map_points",        "type": "map_points",        "label": "Map points" },
    { "key": "o_map_heatmap",       "type": "map_heatmap",       "label": "Map heatmap" },
    { "key": "o_map_choropleth",    "type": "map_choropleth",    "label": "Map choropleth" },
    { "key": "o_map_polygons",      "type": "map_polygons",      "label": "Map polygons" },
    { "key": "o_map_route",         "type": "map_route",         "label": "Map route" },
    { "key": "o_image",         "type": "image",         "label": "Image" },
    { "key": "o_image_grid",    "type": "image_grid",    "label": "Image grid" },
    { "key": "o_image_compare", "type": "image_compare", "label": "Image compare" },
    { "key": "o_audio",         "type": "audio",         "label": "Audio" },
    { "key": "o_video",         "type": "video",         "label": "Video" },
    { "key": "o_latex",  "type": "latex",  "label": "LaTeX" },
    { "key": "o_code",   "type": "code",   "label": "Code", "language": "python" },
    { "key": "o_diff",   "type": "diff",   "label": "Diff" },
    { "key": "o_tree",   "type": "tree",   "label": "Tree" },
    { "key": "o_timeline","type": "timeline","label": "Timeline" },
    { "key": "o_gantt",  "type": "gantt",  "label": "Gantt" },
    { "key": "o_progress","type": "progress","label": "Progress" },
    { "key": "o_log",    "type": "log",    "label": "Log" },
    { "key": "o_stream", "type": "stream_text", "label": "Streaming text" },
    { "key": "o_file",   "type": "file",   "label": "File" }
  ]
}
