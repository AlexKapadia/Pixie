{
  "id": "chat-tool",
  "name": "Chat Tool",
  "description": "Fixture for chat-layout coverage.",
  "version": "0.1.0",
  "category": "fixture",
  "icon": "message-circle",
  "layout": "chat",
  "warm_keep_seconds": 60,
  "max_memory_mb": 128,
  "max_runtime_seconds": 30,
  "inputs": [
    {"key": "messages", "type": "json", "label": "Messages", "default": []},
    {"key": "history", "type": "json", "label": "History", "default": []}
  ],
  "outputs": [
    {"key": "reply", "type": "markdown", "label": "Reply"}
  ]
}
