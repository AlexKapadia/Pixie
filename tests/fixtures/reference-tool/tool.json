{
  "id": "reference-tool",
  "name": "Reference Tool (square root)",
  "description": "Fixture tool exercising check #12 reference-fixtures-match.",
  "version": "0.1.0",
  "category": "fixture",
  "layout": "form",
  "warm_keep_seconds": 60,
  "max_memory_mb": 128,
  "max_runtime_seconds": 5,
  "secrets": [],
  "inputs": [
    {
      "key": "x",
      "type": "number",
      "label": "x",
      "description": "Non-negative number to take the square root of.",
      "default": 4,
      "min": 0,
      "max": 10000000,
      "step": 0.0001
    }
  ],
  "outputs": [
    {
      "key": "result",
      "type": "number",
      "label": "Square root",
      "format": "decimal",
      "precision": 6
    },
    {
      "key": "summary",
      "type": "text",
      "label": "Summary"
    }
  ]
}
