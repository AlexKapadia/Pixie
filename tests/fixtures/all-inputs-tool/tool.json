{
  "id": "all-inputs-tool",
  "name": "All inputs",
  "description": "Smoke fixture exercising every input type renderer.",
  "version": "0.1.0",
  "category": "test",
  "icon": "calculator",
  "layout": "form",
  "warm_keep_seconds": 60,
  "max_memory_mb": 256,
  "max_runtime_seconds": 10,
  "secrets": [],
  "inputs": [
    { "key": "t_text", "type": "text", "label": "Text", "default": "hello" },
    { "key": "t_textarea", "type": "textarea", "label": "Textarea", "monospace": true, "default": "" },
    { "key": "t_number", "type": "number", "label": "Number", "min": 0, "max": 100, "step": 1, "unit": "ms", "default": 42 },
    { "key": "t_slider", "type": "slider", "label": "Slider", "min": 0, "max": 100, "step": 1, "default": 50 },
    { "key": "t_select", "type": "select", "label": "Select", "options": [{"value":"a","label":"Alpha"},{"value":"b","label":"Bravo"}], "default": "a" },
    { "key": "t_multiselect", "type": "multiselect", "label": "Multiselect", "options": [{"value":"x","label":"X"},{"value":"y","label":"Y"},{"value":"z","label":"Z"}], "default": ["x"] },
    { "key": "t_checkbox", "type": "checkbox", "label": "Checkbox", "default": true, "required": false },
    { "key": "t_toggle", "type": "toggle", "label": "Toggle", "default": false, "required": false },
    { "key": "t_radio", "type": "radio", "label": "Radio", "options": [{"value":"one","label":"One"},{"value":"two","label":"Two"}], "default": "one" },
    { "key": "t_date", "type": "date", "label": "Date" },
    { "key": "t_time", "type": "time", "label": "Time" },
    { "key": "t_datetime", "type": "datetime", "label": "Datetime" },
    { "key": "t_date_range", "type": "date_range", "label": "Date range" },
    { "key": "t_file", "type": "file", "label": "File", "multiple": true, "required": false },
    { "key": "t_image", "type": "image", "label": "Image", "required": false },
    { "key": "t_audio", "type": "audio", "label": "Audio", "required": false },
    { "key": "t_colour", "type": "colour", "label": "Colour", "default": "#5563d1" },
    { "key": "t_json", "type": "json", "label": "JSON", "default": {"hello": "world"} },
    { "key": "t_code", "type": "code", "label": "Code", "language": "python", "default": "print('hi')" },
    { "key": "t_markdown", "type": "markdown", "label": "Markdown", "default": "# Heading\n\nSome **bold**." },
    { "key": "t_tags", "type": "tags", "label": "Tags", "suggestions": ["alpha","beta","gamma"], "default": ["alpha"] },
    { "key": "t_autocomplete", "type": "autocomplete", "label": "Autocomplete", "endpoint": "cities", "required": false },
    { "key": "t_table", "type": "table", "label": "Table", "columns": [{"key":"name","label":"Name","type":"text"},{"key":"count","label":"Count","type":"number"}], "min_rows": 1 },
    { "key": "t_map_point", "type": "map_point", "label": "Map point" },
    { "key": "t_map_bbox", "type": "map_bbox", "label": "Map bbox" },
    { "key": "t_map_polygon", "type": "map_polygon", "label": "Map polygon" },
    { "key": "t_map_multipoint", "type": "map_multipoint", "label": "Map multipoint" },
    { "key": "t_hidden", "type": "hidden", "label": "Hidden", "default": "secret-value" }
  ],
  "outputs": [
    { "key": "echo", "type": "kv", "label": "Echoed inputs" }
  ]
}
