{
  "id": "n-body-simulator",
  "name": "N-Body Simulator",
  "description": "Symplectic leapfrog simulation of N gravitating bodies. Plots trajectories, final positions, and energy conservation.",
  "version": "0.1.0",
  "category": "science/dynamics",
  "icon": "orbit",
  "layout": "form",
  "warm_keep_seconds": 300,
  "max_memory_mb": 512,
  "max_runtime_seconds": 60,
  "secrets": [],
  "inputs": [
    {
      "key": "n_bodies",
      "type": "number",
      "label": "Number of bodies",
      "default": 5,
      "min": 2,
      "max": 20,
      "step": 1
    },
    {
      "key": "mass_range",
      "type": "slider",
      "label": "Max mass",
      "description": "Bodies are sampled with mass in [0.1, max].",
      "default": 2.0,
      "min": 0.1,
      "max": 10.0,
      "step": 0.1
    },
    {
      "key": "time_steps",
      "type": "number",
      "label": "Time steps",
      "default": 1500,
      "min": 100,
      "max": 20000,
      "step": 100
    },
    {
      "key": "dt",
      "type": "slider",
      "label": "Step size",
      "default": 0.005,
      "min": 0.001,
      "max": 0.05,
      "step": 0.001
    },
    {
      "key": "seed",
      "type": "number",
      "label": "Random seed",
      "default": 42,
      "min": 0,
      "max": 2147483647,
      "step": 1
    }
  ],
  "outputs": [
    {
      "key": "final_positions",
      "type": "chart_scatter",
      "label": "Final positions"
    },
    {
      "key": "energy",
      "type": "chart_line",
      "label": "Total energy over time"
    },
    {
      "key": "trajectories",
      "type": "chart_line",
      "label": "Trajectory traces (x over time)"
    }
  ]
}
