{
  "id": "bertopic-modelling",
  "name": "BERTopic Modelling",
  "description": "Topic model a CSV of documents using sentence embeddings + UMAP + HDBSCAN via BERTopic. Returns the top words per topic, topic sizes, and a 2-D scatter of documents.",
  "version": "0.1.0",
  "category": "nlp",
  "icon": "layers",
  "layout": "form",
  "warm_keep_seconds": 600,
  "max_memory_mb": 4096,
  "max_runtime_seconds": 300,
  "concurrent": false,
  "secrets": [],
  "inputs": [
    {
      "key": "dataset_csv",
      "type": "file",
      "label": "CSV of documents",
      "accept": ".csv"
    },
    {
      "key": "text_column",
      "type": "text",
      "label": "Text column",
      "default": "text"
    },
    {
      "key": "num_topics",
      "type": "number",
      "label": "Number of topics",
      "description": "Target number of topics. 0 leaves it to HDBSCAN.",
      "default": 6,
      "min": 0,
      "max": 50,
      "step": 1
    }
  ],
  "outputs": [
    {
      "key": "topics_table",
      "type": "table",
      "label": "Topics and top words",
      "columns": [
        {"key": "topic", "label": "Topic", "type": "number"},
        {"key": "count", "label": "Documents", "type": "number"},
        {"key": "top_words", "label": "Top words", "type": "string"}
      ]
    },
    {
      "key": "topic_sizes",
      "type": "chart_bar",
      "label": "Topic sizes"
    },
    {
      "key": "projection",
      "type": "chart_scatter",
      "label": "UMAP projection of documents"
    }
  ]
}
