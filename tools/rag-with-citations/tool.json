{
  "id": "rag-with-citations",
  "name": "RAG with Citations",
  "description": "Embed a collection of text/PDF files, retrieve the top-k chunks for a query, and stream a citation-tagged answer assembled from the chunks. Optionally calls the Anthropic API if a key is present.",
  "version": "0.1.0",
  "category": "nlp/rag",
  "icon": "book-open",
  "layout": "form",
  "warm_keep_seconds": 600,
  "max_memory_mb": 2048,
  "max_runtime_seconds": 120,
  "concurrent": false,
  "secrets": [
    {"key": "ANTHROPIC_API_KEY", "description": "Anthropic API key (optional; enables LLM-synthesised answers).", "required": false}
  ],
  "inputs": [
    {
      "key": "documents",
      "type": "file",
      "label": "Source documents",
      "description": "PDF or plain text. If omitted, a built-in sample corpus is used.",
      "accept": ".pdf,.txt,.md"
    },
    {
      "key": "query",
      "type": "textarea",
      "label": "Query",
      "default": "What is the main topic of these documents?"
    },
    {
      "key": "top_k",
      "type": "number",
      "label": "Top-k chunks",
      "default": 4,
      "min": 1,
      "max": 12,
      "step": 1
    }
  ],
  "outputs": [
    {
      "key": "answer_md",
      "type": "markdown",
      "label": "Answer with citation markers"
    },
    {
      "key": "retrieved",
      "type": "table",
      "label": "Retrieved chunks",
      "columns": [
        {"key": "id", "label": "ID", "type": "string"},
        {"key": "source", "label": "Source", "type": "string"},
        {"key": "score", "label": "Score", "type": "number"},
        {"key": "preview", "label": "Preview", "type": "string"}
      ]
    },
    {
      "key": "answer_stream",
      "type": "stream_text",
      "label": "Streaming answer",
      "streaming": true
    }
  ]
}
