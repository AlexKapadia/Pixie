{
  "id": "stock-monte-carlo",
  "name": "Stock Monte Carlo",
  "description": "Geometric-Brownian-motion Monte Carlo simulation of a stock price path. Reports VaR, CVaR and the terminal price distribution.",
  "version": "0.1.0",
  "category": "finance/quant",
  "icon": "trending-up",
  "layout": "form",
  "warm_keep_seconds": 300,
  "max_memory_mb": 1024,
  "max_runtime_seconds": 60,
  "secrets": [],
  "inputs": [
    {
      "key": "spot_price",
      "type": "number",
      "label": "Spot price",
      "description": "Current price of the underlying.",
      "default": 100.0,
      "min": 0.01,
      "max": 1000000.0,
      "step": 0.01,
      "unit": "£"
    },
    {
      "key": "drift",
      "type": "slider",
      "label": "Annual drift (%)",
      "description": "Expected annualised return.",
      "default": 8.0,
      "min": -20.0,
      "max": 50.0,
      "step": 0.5
    },
    {
      "key": "volatility",
      "type": "slider",
      "label": "Annual volatility (%)",
      "description": "Annualised standard deviation of log returns.",
      "default": 25.0,
      "min": 1.0,
      "max": 100.0,
      "step": 0.5
    },
    {
      "key": "days",
      "type": "number",
      "label": "Horizon (trading days)",
      "description": "Number of trading days to simulate.",
      "default": 252,
      "min": 1,
      "max": 1825,
      "step": 1
    },
    {
      "key": "paths",
      "type": "number",
      "label": "Paths",
      "description": "Number of independent simulated paths.",
      "default": 5000,
      "min": 100,
      "max": 100000,
      "step": 100
    },
    {
      "key": "seed",
      "type": "number",
      "label": "Random seed",
      "description": "Set for reproducible runs. Leave 0 for non-deterministic.",
      "default": 42,
      "min": 0,
      "max": 2147483647,
      "step": 1
    }
  ],
  "outputs": [
    {
      "key": "var_95",
      "type": "number",
      "label": "Value-at-risk (95%)",
      "format": "currency",
      "precision": 2
    },
    {
      "key": "cvar_95",
      "type": "number",
      "label": "Conditional VaR (95%)",
      "format": "currency",
      "precision": 2
    },
    {
      "key": "price_paths",
      "type": "chart_line",
      "label": "Sample paths and percentile bands"
    },
    {
      "key": "daily_stats",
      "type": "table",
      "label": "Per-day percentile statistics",
      "columns": [
        {"key": "day", "label": "Day", "type": "number"},
        {"key": "p05", "label": "5th pct", "type": "number"},
        {"key": "p50", "label": "Median", "type": "number"},
        {"key": "p95", "label": "95th pct", "type": "number"},
        {"key": "mean", "label": "Mean", "type": "number"}
      ]
    },
    {
      "key": "moments",
      "type": "kv",
      "label": "Terminal price distribution"
    }
  ]
}
