{
  "id": "dowhy-causal-ate",
  "name": "Causal ATE Estimator",
  "description": "Estimate the average treatment effect of a binary treatment on an outcome with optional confounders using linear regression, IPW, and a doubly robust check.",
  "version": "0.1.0",
  "category": "stats/causal",
  "icon": "git-compare",
  "layout": "form",
  "warm_keep_seconds": 300,
  "max_memory_mb": 512,
  "max_runtime_seconds": 60,
  "secrets": [],
  "inputs": [
    {
      "key": "csv_file",
      "type": "file",
      "label": "CSV dataset",
      "description": "CSV with treatment, outcome, and optional confounder columns.",
      "accept": [".csv"]
    },
    {
      "key": "treatment",
      "type": "text",
      "label": "Treatment column",
      "default": "treatment"
    },
    {
      "key": "outcome",
      "type": "text",
      "label": "Outcome column",
      "default": "outcome"
    },
    {
      "key": "confounders",
      "type": "tags",
      "label": "Confounders",
      "description": "Column names of measured confounders.",
      "default": []
    }
  ],
  "outputs": [
    {
      "key": "ate",
      "type": "number",
      "label": "ATE estimate",
      "format": "decimal",
      "precision": 4
    },
    {
      "key": "ci_lower",
      "type": "number",
      "label": "95% CI lower",
      "format": "decimal",
      "precision": 4
    },
    {
      "key": "ci_upper",
      "type": "number",
      "label": "95% CI upper",
      "format": "decimal",
      "precision": 4
    },
    {
      "key": "refutations",
      "type": "chart_bar",
      "label": "Refutation checks"
    },
    {
      "key": "explanation",
      "type": "markdown",
      "label": "Causal-graph notes"
    }
  ]
}
