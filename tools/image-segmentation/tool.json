{
  "id": "image-segmentation",
  "name": "Image Segmentation",
  "description": "Foreground / background segmentation. Returns the cut-out image, the binary mask and a per-class pixel count.",
  "version": "0.1.0",
  "category": "ml/inference",
  "icon": "scissors",
  "layout": "form",
  "warm_keep_seconds": 1800,
  "max_memory_mb": 4096,
  "max_runtime_seconds": 120,
  "secrets": [],
  "inputs": [
    {
      "key": "image",
      "type": "image",
      "label": "Image"
    },
    {
      "key": "model",
      "type": "select",
      "label": "Model",
      "default": "u2net",
      "options": [
        {"value": "u2net", "label": "U2Net (general)"},
        {"value": "silueta", "label": "Silueta (people)"}
      ]
    },
    {
      "key": "output_format",
      "type": "select",
      "label": "Output format",
      "default": "cutout",
      "options": [
        {"value": "cutout", "label": "Cut-out (transparent background)"},
        {"value": "mask", "label": "Binary mask only"}
      ]
    }
  ],
  "outputs": [
    {
      "key": "segmented",
      "type": "image",
      "label": "Segmented image"
    },
    {
      "key": "mask",
      "type": "image",
      "label": "Binary mask"
    },
    {
      "key": "stats",
      "type": "table",
      "label": "Per-region pixel counts",
      "columns": [
        {"key": "region", "label": "Region", "type": "string"},
        {"key": "pixels", "label": "Pixels", "type": "number"},
        {"key": "fraction", "label": "Fraction", "type": "number"}
      ]
    }
  ]
}
