{
  "id": "pymc-bayesian-ab",
  "name": "Bayesian A/B Test",
  "description": "Compare two binomial conversion rates using a Beta-Binomial conjugate model; reports posterior overlap, probability variant beats control, expected lift, and a decision recommendation.",
  "version": "0.1.0",
  "category": "stats/experimentation",
  "icon": "scale",
  "layout": "form",
  "warm_keep_seconds": 300,
  "max_memory_mb": 256,
  "max_runtime_seconds": 20,
  "secrets": [],
  "inputs": [
    {
      "key": "control_conversions",
      "type": "number",
      "label": "Control conversions",
      "default": 100,
      "min": 0,
      "step": 1
    },
    {
      "key": "control_total",
      "type": "number",
      "label": "Control total",
      "default": 1000,
      "min": 1,
      "step": 1
    },
    {
      "key": "variant_conversions",
      "type": "number",
      "label": "Variant conversions",
      "default": 130,
      "min": 0,
      "step": 1
    },
    {
      "key": "variant_total",
      "type": "number",
      "label": "Variant total",
      "default": 1000,
      "min": 1,
      "step": 1
    },
    {
      "key": "prior_strength",
      "type": "slider",
      "label": "Prior strength",
      "description": "Effective sample size of the Beta(1+a, 1+b) prior. Higher = more conservative.",
      "default": 2.0,
      "min": 0.0,
      "max": 100.0,
      "step": 0.5
    }
  ],
  "outputs": [
    {
      "key": "posteriors",
      "type": "chart_line",
      "label": "Posterior conversion rate densities"
    },
    {
      "key": "p_variant_better",
      "type": "number",
      "label": "P(variant > control)",
      "format": "percent",
      "precision": 2
    },
    {
      "key": "expected_lift",
      "type": "number",
      "label": "Expected relative lift",
      "format": "percent",
      "precision": 2
    },
    {
      "key": "recommendation",
      "type": "markdown",
      "label": "Decision recommendation"
    }
  ]
}
