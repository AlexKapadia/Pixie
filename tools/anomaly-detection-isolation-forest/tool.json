{
  "id": "anomaly-detection-isolation-forest",
  "name": "Anomaly Detection (Isolation Forest)",
  "description": "Fit an Isolation Forest to a univariate time series, highlight detected anomalies, and report the score distribution.",
  "version": "0.1.0",
  "category": "ml/anomaly",
  "icon": "alert-triangle",
  "layout": "form",
  "warm_keep_seconds": 300,
  "max_memory_mb": 512,
  "max_runtime_seconds": 60,
  "secrets": [],
  "inputs": [
    {
      "key": "csv_file",
      "type": "file",
      "label": "CSV time series",
      "description": "CSV with a timestamp column and a numeric value column.",
      "accept": [".csv"]
    },
    {
      "key": "value_column",
      "type": "text",
      "label": "Value column",
      "default": "value"
    },
    {
      "key": "timestamp_column",
      "type": "text",
      "label": "Timestamp column",
      "default": "timestamp"
    },
    {
      "key": "contamination",
      "type": "slider",
      "label": "Contamination (%)",
      "description": "Expected proportion of anomalies in the data.",
      "default": 5.0,
      "min": 0.5,
      "max": 50.0,
      "step": 0.5
    },
    {
      "key": "top_n",
      "type": "slider",
      "label": "Top-N anomalies to list",
      "default": 20,
      "min": 5,
      "max": 100,
      "step": 1
    }
  ],
  "outputs": [
    {
      "key": "series",
      "type": "chart_line",
      "label": "Series with anomalies highlighted"
    },
    {
      "key": "top_anomalies",
      "type": "table",
      "label": "Top anomalies",
      "downloadable": true
    },
    {
      "key": "summary",
      "type": "kv",
      "label": "Anomaly summary"
    },
    {
      "key": "score_distribution",
      "type": "chart_histogram",
      "label": "Anomaly score distribution"
    }
  ]
}
