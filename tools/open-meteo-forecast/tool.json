{
  "id": "open-meteo-forecast",
  "name": "Open-Meteo Forecast",
  "description": "Fetch a multi-day weather forecast for any geographic point using the free Open-Meteo API and visualise temperature, precipitation, and a daily summary.",
  "version": "0.1.0",
  "category": "geo/weather",
  "icon": "cloud",
  "layout": "form",
  "warm_keep_seconds": 300,
  "max_memory_mb": 256,
  "max_runtime_seconds": 30,
  "secrets": [],
  "inputs": [
    {
      "key": "location",
      "type": "map_point",
      "label": "Forecast location",
      "description": "Click on the map to choose a location.",
      "default_center": [51.5, -0.12],
      "default_zoom": 5
    },
    {
      "key": "days_ahead",
      "type": "slider",
      "label": "Days ahead",
      "description": "Forecast horizon (1-16 days).",
      "default": 7,
      "min": 1,
      "max": 16,
      "step": 1
    }
  ],
  "outputs": [
    {
      "key": "temperature",
      "type": "chart_line",
      "label": "Temperature with min/max band",
      "y_label": "°C"
    },
    {
      "key": "precipitation",
      "type": "chart_line",
      "label": "Daily precipitation",
      "y_label": "mm"
    },
    {
      "key": "today",
      "type": "kv",
      "label": "Today's summary"
    },
    {
      "key": "location_marker",
      "type": "map_points",
      "label": "Forecast location"
    }
  ]
}
