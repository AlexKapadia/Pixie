{
  "id": "graph-algorithms-playground",
  "name": "Graph Algorithms Playground",
  "description": "Run Dijkstra shortest-path, max-flow, or community detection on a weighted graph supplied as edge text and visualise the result on the network.",
  "version": "0.1.0",
  "category": "algorithms/graphs",
  "icon": "share-2",
  "layout": "form",
  "warm_keep_seconds": 300,
  "max_memory_mb": 512,
  "max_runtime_seconds": 30,
  "secrets": [],
  "inputs": [
    {
      "key": "edges",
      "type": "code",
      "label": "Edges",
      "description": "One edge per line, format 'a-b:weight'. Lines starting with # are comments.",
      "language": "text",
      "default": "a-b:1\nb-c:2\na-c:5\nc-d:1\nb-d:4"
    },
    {
      "key": "algorithm",
      "type": "select",
      "label": "Algorithm",
      "default": "dijkstra",
      "options": [
        {"value": "dijkstra", "label": "Dijkstra shortest path"},
        {"value": "max_flow", "label": "Maximum flow"},
        {"value": "community_detection", "label": "Greedy modularity communities"}
      ]
    },
    {
      "key": "source",
      "type": "text",
      "label": "Source node",
      "default": "a"
    },
    {
      "key": "sink",
      "type": "text",
      "label": "Sink node (max-flow only)",
      "default": "d"
    }
  ],
  "outputs": [
    {
      "key": "graph_view",
      "type": "chart_network",
      "label": "Network with result highlighted"
    },
    {
      "key": "details",
      "type": "table",
      "label": "Per-node or per-edge result",
      "downloadable": true
    },
    {
      "key": "summary",
      "type": "kv",
      "label": "Algorithm summary"
    }
  ]
}
