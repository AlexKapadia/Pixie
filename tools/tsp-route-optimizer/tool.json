{
  "id": "tsp-route-optimizer",
  "name": "TSP Route Optimiser",
  "description": "Solve the travelling salesman problem on a set of points and visualise the optimal tour on a map.",
  "version": "0.1.0",
  "category": "geo/optimisation",
  "icon": "route",
  "layout": "form",
  "warm_keep_seconds": 300,
  "max_memory_mb": 512,
  "max_runtime_seconds": 60,
  "secrets": [],
  "inputs": [
    {
      "key": "cities",
      "type": "map_multipoint",
      "label": "Cities",
      "description": "Click on the map to add the cities to visit.",
      "default_center": [51.5, -0.12],
      "default_zoom": 5
    },
    {
      "key": "return_to_start",
      "type": "toggle",
      "label": "Return to start",
      "description": "Close the tour by returning to the first city.",
      "default": true
    }
  ],
  "outputs": [
    {
      "key": "route_map",
      "type": "map_route",
      "label": "Optimal route"
    },
    {
      "key": "total_distance_km",
      "type": "number",
      "label": "Total distance (km)",
      "format": "decimal",
      "precision": 2
    },
    {
      "key": "legs",
      "type": "table",
      "label": "Per-leg distances",
      "downloadable": true
    }
  ]
}
