{
  "id": "vit-classifier-gradcam",
  "name": "ViT Classifier + Grad-CAM",
  "description": "Vision-Transformer image classification with a Grad-CAM heatmap explaining the top prediction.",
  "version": "0.1.0",
  "category": "ml/inference",
  "icon": "image-up",
  "layout": "form",
  "warm_keep_seconds": 1800,
  "max_memory_mb": 4096,
  "max_runtime_seconds": 120,
  "secrets": [],
  "inputs": [
    {
      "key": "image",
      "type": "image",
      "label": "Image"
    },
    {
      "key": "top_k",
      "type": "number",
      "label": "Top K",
      "default": 5,
      "min": 1,
      "max": 10,
      "step": 1
    }
  ],
  "outputs": [
    {
      "key": "predictions",
      "type": "kv",
      "label": "Top-K predictions"
    },
    {
      "key": "explanation",
      "type": "image_compare",
      "label": "Original vs Grad-CAM overlay"
    }
  ]
}
