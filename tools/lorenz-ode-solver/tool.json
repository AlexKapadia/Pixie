{
  "id": "lorenz-ode-solver",
  "name": "Lorenz ODE Solver",
  "description": "Integrate the Lorenz attractor for chosen sigma/rho/beta parameters and plot time series, phase portrait, and Poincare section.",
  "version": "0.1.0",
  "category": "science/dynamics",
  "icon": "git-branch",
  "layout": "form",
  "warm_keep_seconds": 300,
  "max_memory_mb": 512,
  "max_runtime_seconds": 30,
  "secrets": [],
  "inputs": [
    {
      "key": "sigma",
      "type": "slider",
      "label": "sigma",
      "description": "Prandtl number.",
      "default": 10.0,
      "min": 0.1,
      "max": 30.0,
      "step": 0.1
    },
    {
      "key": "rho",
      "type": "slider",
      "label": "rho",
      "description": "Rayleigh number.",
      "default": 28.0,
      "min": 0.1,
      "max": 60.0,
      "step": 0.1
    },
    {
      "key": "beta",
      "type": "slider",
      "label": "beta",
      "description": "Geometric factor.",
      "default": 2.6666667,
      "min": 0.1,
      "max": 10.0,
      "step": 0.01
    },
    {
      "key": "t_max",
      "type": "slider",
      "label": "Integration horizon",
      "description": "Total simulation time.",
      "default": 40.0,
      "min": 1.0,
      "max": 200.0,
      "step": 1.0
    },
    {
      "key": "dt",
      "type": "number",
      "label": "Output step",
      "description": "Sampling interval for plotting.",
      "default": 0.01,
      "min": 0.001,
      "max": 0.5,
      "step": 0.001
    }
  ],
  "outputs": [
    {
      "key": "time_series",
      "type": "chart_line",
      "label": "x, y, z over time"
    },
    {
      "key": "phase_portrait",
      "type": "chart_scatter",
      "label": "Phase portrait (x vs z)"
    },
    {
      "key": "poincare",
      "type": "chart_line",
      "label": "Poincare section (z=27 plane crossings)"
    }
  ]
}
