{
  "id": "yolo-object-detection",
  "name": "YOLO Object Detection",
  "description": "Detect objects in an image with YOLOv8. Returns annotated image plus a table of detections.",
  "version": "0.1.0",
  "category": "ml/inference",
  "icon": "scan-search",
  "layout": "form",
  "warm_keep_seconds": 1800,
  "max_memory_mb": 4096,
  "max_runtime_seconds": 120,
  "secrets": [],
  "inputs": [
    {
      "key": "image",
      "type": "image",
      "label": "Image",
      "description": "Image to run detection on."
    },
    {
      "key": "confidence_threshold",
      "type": "slider",
      "label": "Confidence threshold (%)",
      "default": 25.0,
      "min": 1.0,
      "max": 99.0,
      "step": 1.0
    },
    {
      "key": "model",
      "type": "select",
      "label": "Model",
      "default": "yolov8n",
      "options": [
        {"value": "yolov8n", "label": "YOLOv8n (nano)"},
        {"value": "yolov8s", "label": "YOLOv8s (small)"}
      ]
    }
  ],
  "outputs": [
    {
      "key": "annotated",
      "type": "image",
      "label": "Annotated image"
    },
    {
      "key": "detections",
      "type": "table",
      "label": "Detections",
      "columns": [
        {"key": "class_name", "label": "Class", "type": "string"},
        {"key": "confidence", "label": "Confidence", "type": "number"},
        {"key": "x1", "label": "x1", "type": "number"},
        {"key": "y1", "label": "y1", "type": "number"},
        {"key": "x2", "label": "x2", "type": "number"},
        {"key": "y2", "label": "y2", "type": "number"}
      ]
    },
    {
      "key": "summary",
      "type": "kv",
      "label": "Summary"
    }
  ]
}
