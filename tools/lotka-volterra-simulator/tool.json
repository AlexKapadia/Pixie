{
  "id": "lotka-volterra-simulator",
  "name": "Lotka-Volterra Simulator",
  "description": "Integrate the predator-prey Lotka-Volterra equations and visualise population dynamics, phase portrait, and equilibrium points.",
  "version": "0.1.0",
  "category": "science/dynamics",
  "icon": "activity",
  "layout": "form",
  "warm_keep_seconds": 300,
  "max_memory_mb": 256,
  "max_runtime_seconds": 30,
  "secrets": [],
  "inputs": [
    {
      "key": "alpha",
      "type": "slider",
      "label": "alpha (prey growth)",
      "default": 1.1,
      "min": 0.1,
      "max": 5.0,
      "step": 0.05
    },
    {
      "key": "beta",
      "type": "slider",
      "label": "beta (predation rate)",
      "default": 0.4,
      "min": 0.05,
      "max": 3.0,
      "step": 0.05
    },
    {
      "key": "gamma",
      "type": "slider",
      "label": "gamma (predator death)",
      "default": 0.4,
      "min": 0.05,
      "max": 3.0,
      "step": 0.05
    },
    {
      "key": "delta",
      "type": "slider",
      "label": "delta (predator efficiency)",
      "default": 0.1,
      "min": 0.01,
      "max": 2.0,
      "step": 0.01
    },
    {
      "key": "initial_prey",
      "type": "number",
      "label": "Initial prey",
      "default": 10.0,
      "min": 0.1,
      "max": 1000.0,
      "step": 0.1
    },
    {
      "key": "initial_predator",
      "type": "number",
      "label": "Initial predator",
      "default": 5.0,
      "min": 0.1,
      "max": 1000.0,
      "step": 0.1
    },
    {
      "key": "t_max",
      "type": "slider",
      "label": "Integration horizon",
      "default": 50.0,
      "min": 5.0,
      "max": 200.0,
      "step": 1.0
    }
  ],
  "outputs": [
    {
      "key": "populations",
      "type": "chart_line",
      "label": "Populations over time"
    },
    {
      "key": "phase_portrait",
      "type": "chart_scatter",
      "label": "Prey vs predator phase portrait"
    },
    {
      "key": "equilibria",
      "type": "kv",
      "label": "Equilibrium points"
    }
  ]
}
