{
  "id": "black-scholes-greeks",
  "name": "Black–Scholes Greeks",
  "description": "Closed-form European option pricer with the full first-order Greeks and a strike × time heatmap.",
  "version": "0.1.0",
  "category": "finance/quant",
  "icon": "function-square",
  "layout": "form",
  "warm_keep_seconds": 300,
  "max_memory_mb": 256,
  "max_runtime_seconds": 15,
  "secrets": [],
  "inputs": [
    {
      "key": "spot",
      "type": "number",
      "label": "Spot price",
      "description": "Current price of the underlying.",
      "default": 100.0,
      "min": 0.01,
      "max": 1000000.0,
      "step": 0.01,
      "unit": "£"
    },
    {
      "key": "strike",
      "type": "number",
      "label": "Strike price",
      "default": 100.0,
      "min": 0.01,
      "max": 1000000.0,
      "step": 0.01,
      "unit": "£"
    },
    {
      "key": "days_to_expiry",
      "type": "number",
      "label": "Days to expiry",
      "default": 30,
      "min": 1,
      "max": 3650,
      "step": 1
    },
    {
      "key": "rate",
      "type": "slider",
      "label": "Risk-free rate (%)",
      "default": 4.0,
      "min": 0.0,
      "max": 10.0,
      "step": 0.1
    },
    {
      "key": "volatility",
      "type": "slider",
      "label": "Volatility (%)",
      "default": 20.0,
      "min": 1.0,
      "max": 100.0,
      "step": 0.5
    },
    {
      "key": "option_type",
      "type": "select",
      "label": "Option type",
      "default": "call",
      "options": [
        {"value": "call", "label": "Call"},
        {"value": "put", "label": "Put"}
      ]
    }
  ],
  "outputs": [
    {
      "key": "price",
      "type": "number",
      "label": "Option price",
      "format": "currency",
      "precision": 4
    },
    {
      "key": "greeks",
      "type": "kv",
      "label": "Greeks"
    },
    {
      "key": "price_vs_spot",
      "type": "chart_line",
      "label": "Price vs spot"
    },
    {
      "key": "price_vs_days",
      "type": "chart_line",
      "label": "Price vs days to expiry"
    },
    {
      "key": "heatmap",
      "type": "chart_heatmap",
      "label": "Price across strike × time"
    }
  ]
}
