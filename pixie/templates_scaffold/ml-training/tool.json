{
  "id": "{{TOOL_ID}}",
  "name": "{{TOOL_NAME}}",
  "description": "{{DESCRIPTION}}",
  "version": "0.1.0",
  "category": "ml",
  "icon": "trending-up",
  "layout": "form",
  "warm_keep_seconds": 900,
  "max_memory_mb": 4096,
  "max_runtime_seconds": 600,
  "concurrent": false,
  "requires_data_persistence": true,
  "secrets": [],
  "inputs": [
    {
      "key": "dataset",
      "type": "file",
      "label": "Training data (CSV)",
      "description": "CSV with feature columns and one target column.",
      "accept": ".csv"
    },
    {
      "key": "epochs",
      "type": "slider",
      "label": "Epochs",
      "default": 10,
      "min": 1,
      "max": 100,
      "step": 1
    },
    {
      "key": "learning_rate",
      "type": "slider",
      "label": "Learning rate",
      "default": 0.01,
      "min": 0.0001,
      "max": 1.0,
      "step": 0.0001
    }
  ],
  "outputs": [
    {
      "key": "loss_curve",
      "type": "chart_line",
      "label": "Training loss",
      "streaming": true
    },
    {
      "key": "summary",
      "type": "table",
      "label": "Per-epoch summary",
      "columns": [
        {"key": "epoch", "label": "Epoch", "type": "number"},
        {"key": "loss", "label": "Loss", "type": "number"},
        {"key": "val_loss", "label": "Val loss", "type": "number"}
      ]
    }
  ]
}
